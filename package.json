{
  "name": "pickup",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@supabase/supabase-js": "^2.108.1",
    "expo": "~56.0.9",
    "expo-constants": "~56.0.17",
    "expo-font": "~56.0.7",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-router": "~56.2.9",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-svg-transformer": "^1.5.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "tailwind-merge": "^3.6.0",
    "uniwind": "^1.8.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.6",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm test",
    "lint": "expo lint",
    "format": "prettier --write .",
    "users:invite": "node --env-file=.env --env-file=.env.local scripts/invite-users.mjs",
    "users:delete": "node --env-file=.env --env-file=.env.local scripts/delete-user.mjs",
    "users:invite:hosted": "node --env-file=.env --env-file=.env.hosted.local scripts/invite-users.mjs --hosted",
    "users:delete:hosted": "node --env-file=.env --env-file=.env.hosted.local scripts/delete-user.mjs --hosted",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts && prettier --write lib/database.types.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/fixtures/"
    ]
  }
}
