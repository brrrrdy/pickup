# Points the app and the local user scripts at the local Supabase stack (npx supabase start).
# Copy to .env.local (git-ignored) and fill in from `npx supabase status`.
# The hosted secret key never goes here: it belongs in .env.hosted.local.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
